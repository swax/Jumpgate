{
  "name": "vscode-perspective",
  "displayName": "VS Code Perspective",
  "description": "A viewer for .vscp files",
  "version": "0.0.1",
  "publisher": "publisher-name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/vscode-perspective"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "perspective.vscpPreview",
        "displayName": "VSCP Preview",
        "selector": [
          {
            "filenamePattern": "*.vscp"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "build:webview": "esbuild src/webview/main.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --sourcemap",
    "build": "npm run build:extension && npm run build:webview",
    "watch:extension": "npm run build:extension -- --watch",
    "watch:webview": "npm run build:webview -- --watch",
    "watch": "npm run watch:extension & npm run watch:webview",
    "lint": "eslint src/",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "konva": "^10.2.0",
    "zod": "^3.24.0"
  }
}
