    {
      "id": "subtitle",
      "bounds": { "x": 40, "y": -90, "width": 800, "height": 60 },
      "label": "Build and ride snowboard courses. Author in Slopesmith or import from your own disc,\nride it in the browser or on a standalone Quest — or pack it back onto a PS2 disc.",
      "shape": "text"
    },
    {
      "id": "legal-note",
      "bounds": { "x": 1080, "y": -90, "width": 760, "height": 60 },
      "label": "No retail asset, executable, or disc content. Behavior is implemented from Trailmap;\nanything read off a disc stays in gitignored folders on your machine.",
      "shape": "text"
    },

