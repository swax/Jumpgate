{
  "name": "jumpgate-vscode",
  "displayName": "Jumpgate",
  "description": "A viewer for .jg diagram files",
  "version": "0.0.1",
  "publisher": "publisher-name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swax/jumpgate"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jumpgate.linkToNode",
        "title": "Jumpgate: Link to Node/Edge"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "jumpgate.linkToNode",
          "group": "z_jumpgate"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "jumpgate.preview",
        "displayName": "Jumpgate Preview",
        "selector": [
          {
            "filenamePattern": "*.jg"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "build:webview": "esbuild src/webview/main.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --sourcemap",
    "build": "npm run build:extension && npm run build:webview",
    "watch:extension": "npm run build:extension -- --watch",
    "watch:webview": "npm run build:webview -- --watch",
    "watch": "npm run watch:extension & npm run watch:webview",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "jumpgate": "*"
  }
}
