{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "paths": {
      "jumpgate": ["../jumpgate/src/index.ts"],
      "jumpgate/schema": ["../jumpgate/src/schema.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
